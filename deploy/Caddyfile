{$DEV_DOMAIN} {
	encode zstd gzip

	# Zipkin은 자체 인증이 없으므로 OCI Vault에서 주입한 bcrypt 해시로 보호한다.
	handle /zipkin* {
		basic_auth {
			dev {$ZIPKIN_BASIC_AUTH_HASH}
		}
		reverse_proxy zipkin:9411
	}

	handle {
		@unauthorized_signup {
			method POST
			path /api/v1/users
			not header X-Dev-Provision-Key {$DEV_PROVISION_KEY}
		}
		respond @unauthorized_signup "X-Dev-Provision-Key is required" 403

		reverse_proxy gateway:8080
	}
}
